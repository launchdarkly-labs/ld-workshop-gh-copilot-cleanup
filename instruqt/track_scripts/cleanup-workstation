#!/bin/bash

SCRIPT_DIR="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"

cd /opt/ld/terraform-ld-student
terraform destroy -auto-approve || true

# The LD project for this session is destroyed by terraform above, so any
# residual MCP entry in the pool user's Copilot settings points at a dead
# API token. The next learner overwrites it in Challenge 2.

# Release the GitHub pool user. Best-effort: the TTL sweeper is the safety
# net if this fails (e.g. AWS creds expired mid-session).
export AWS_REGION="${AWS_REGION:-us-east-1}"
PYTHONPATH="/opt/ld/util" python3 "/opt/ld/util/pool.py" release \
    || echo "pool release failed; sweeper will recover the row"
