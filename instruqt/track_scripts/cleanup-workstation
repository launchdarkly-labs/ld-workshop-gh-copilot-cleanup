#!/bin/bash

SCRIPT_DIR="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"

cd /opt/ld/terraform-ld-student
terraform destroy -auto-approve || true

# Reset the pool user's MCP config so the LD API key written in Challenge 2
# doesn't leak into the next session that gets this account. Source the
# bash profile because cleanup-workstation runs in a fresh shell.
# shellcheck disable=SC1091
[ -f ~/.profile ] && . ~/.profile
if [ -n "${GITHUB_TOKEN:-}" ]; then
    curl -fsS -X PUT \
        -H "Authorization: Bearer $GITHUB_TOKEN" \
        -H "Accept: application/vnd.github+json" \
        https://api.github.com/user/copilot/coding-agent/mcp-config \
        -d '{"mcpServers": {}}' >/dev/null 2>&1 \
        || echo "MCP reset failed; the next consumer of this account will see leftover config"
fi

# Release the GitHub pool user. Best-effort: the TTL sweeper is the safety
# net if this fails (e.g. AWS creds expired mid-session).
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-2}"
PYTHONPATH="$SCRIPT_DIR/lib" python3 "$SCRIPT_DIR/lib/pool.py" release \
    || echo "pool release failed; sweeper will recover the row"
